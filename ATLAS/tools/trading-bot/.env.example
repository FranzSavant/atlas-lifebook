# Binance — https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here
# Optional: use testnet (https://testnet.binance.vision)
BINANCE_TESTNET=false

# Trading pair & interval — do not change without adjusting watermarks
SYMBOL=BTCUSDT
INTERVAL=5m

# Optional overrides (defaults in src/config.ts)
# SNAPSHOT_EVERY=500
# RECONCILE_DELAY_MS=2000
# WARMUP_DRAW_CANDLES=5000
# LIVE_CANDLES=6000
# HOT_CAPACITY=15000
